SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SQUARE_TOKEN_KEY=
# Hosted deployment only; local Vite OAuth keeps its loopback redirect.
SQUARE_APP_ORIGIN=https://myas-tool.vercel.app

# Backend phase 1. Use Supabase's transaction-pooler URL for runtime access.
POSTGRES_URL=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Exact app origins, comma-separated; do not use wildcards.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,https://myas-tool.vercel.app

# Local migrations only; privileged and must not be configured in Vercel.
# SUPABASE_MIGRATION_URL=
